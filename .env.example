DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
GITHUB_TOKEN=
REPO_CACHE_DIR=.cache/repos
REVIEW_AGENT_DATABASE_URL=postgresql+psycopg://review_agent:review_agent@localhost:5432/review_agent
REVIEW_AGENT_DATA_ROOT=~/.review-agent
REVIEW_AGENT_API_URL=http://127.0.0.1:8000
REVIEW_AGENT_CELERY_BROKER=redis://localhost:6379/0
# Default is docker. Use host only for explicit local-dev / old PR verification tools.
# Compose forces host in compose.yaml (containers cannot nest docker run).
REVIEW_AGENT_EXECUTOR_BACKEND=docker
# REVIEW_AGENT_EXECUTOR_BACKEND=host
REVIEW_AGENT_TASK_IMAGE=python:3.12-slim
REVIEW_AGENT_SKILLS_ENABLED=true
REVIEW_AGENT_CONTEXT_OPTIMIZATION=true
# Default confirm: Web must click 允许. auto skips write confirmation (scripted experiments only).
# REVIEW_AGENT_APPROVAL_MODE=confirm
# JSON array; empty means do not start MCP processes.
# Compose defaults to [] via ${REVIEW_AGENT_MCP_SERVERS:-[]}; set this to enable segment-2 MCP.
# REVIEW_AGENT_MCP_SERVERS=[{"server_id":"api_contract","command":["python","-m","review_agent.mcp_servers.api_contract"],"env_allowlist":["PYTHONPATH","REVIEW_AGENT_CONTRACT_ROOT"],"timeout_seconds":30}]
# REVIEW_AGENT_CONTRACT_ROOT=examples/contracts
# Compose pip mirror (compose.yaml / Dockerfile.compose already set these):
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
