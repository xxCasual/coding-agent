{
  "openapi": "3.1.0",
  "info": {
    "title": "Items API unsupported combination",
    "version": "0.0.1"
  },
  "paths": {
    "/items": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created with unsupported combinator",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["id"],
                      "properties": { "id": { "type": "string" } }
                    },
                    {
                      "type": "object",
                      "required": ["uuid"],
                      "properties": { "uuid": { "type": "string" } }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
